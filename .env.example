PORT=3000
PETS_SERVICE_URL=https://vetflow-ms-pets.SEU-AMBIENTE.brazilsouth.azurecontainerapps.io
APPOINTMENTS_SERVICE_URL=https://vetflow-ms-appointments.SEU-AMBIENTE.brazilsouth.azurecontainerapps.io
FUNCTIONS_URL=https://vetflow-functions-SEU-NOME.azurewebsites.net/api
# FUNCTIONS_KEY=  (só se as Functions usarem authLevel function)
# Segredo que o API Gateway injeta no cabeçalho x-gateway-secret. Sem ele, o BFF aceita chamadas diretas.
GATEWAY_SECRET=
# URL pública do API Gateway (aparece como servidor no Swagger do BFF)
GATEWAY_PUBLIC_URL=https://vetflow-apim.azure-api.net/vetflow
CORS_ORIGIN=*
UPSTREAM_TIMEOUT_MS=10000
